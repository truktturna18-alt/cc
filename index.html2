<!doctype html><html><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover"><meta name="theme-color" content="#06080b"><title>Cha Ching Vault</title><style id="cccss">
#ccApp{font-family:-apple-system,BlinkMacSystemFont,ui-monospace,Menlo,monospace;background:#06080b;color:#d9ffe8;max-width:700px;margin:0 auto;padding:14px;border-radius:18px;box-sizing:border-box;position:relative;overflow:hidden;min-height:740px;box-shadow:0 0 0 1px #16321f}
#ccApp *{box-sizing:border-box}
.hide{display:none!important}
.brand{font-size:36px;letter-spacing:6px;font-weight:800;color:#39ff9b;text-align:center;margin-top:30px}
.brand2{font-size:12px;letter-spacing:10px;color:#8fd9b3;text-align:center;margin-bottom:20px}
.lockbox{background:#0a0f14;border:1px solid #1b3a28;border-radius:16px;padding:18px;max-width:360px;margin:0 auto}
.dots{display:flex;gap:16px;justify-content:center;margin:10px 0 20px}
.dot{width:18px;height:18px;border-radius:50%;border:2px solid #2c5c40}
.dot.on{background:#39ff9b;border-color:#39ff9b}
.pad{display:grid;grid-template-columns:repeat(3,1fr);gap:10px}
.pad button{padding:20px 0;font-size:24px;font-weight:700;font-family:inherit;background:#0f1a14;color:#d9ffe8;border:1px solid #23492f;border-radius:14px;cursor:pointer}
.pad .act{background:#123322;color:#39ff9b;font-size:14px}
.hint{text-align:center;font-size:15px;color:#39ff9b;margin-top:14px;min-height:20px;font-weight:700}
.top{display:flex;justify-content:space-between;align-items:center;gap:8px;border-bottom:1px solid #17301f;padding-bottom:10px;margin-bottom:10px;flex-wrap:wrap}
.top h1{font-size:14px;letter-spacing:4px;margin:0;color:#39ff9b}
.balchip{background:#0d1a12;border:1px solid #1f4a30;border-radius:10px;padding:7px 12px;font-size:14px;color:#8fffbf}
button.mini{background:#10241a;border:1px solid #245139;color:#9dffc8;font-family:inherit;font-size:11px;padding:9px 12px;border-radius:9px;cursor:pointer;letter-spacing:1px}
button.save{background:#39ff9b;color:#04140b;font-weight:900;font-size:13px;padding:12px 16px;border:0;border-radius:9px;font-family:inherit;cursor:pointer}
.banner{background:#0e2a1b;border:1px solid #39ff9b;border-radius:11px;padding:11px;font-size:13px;color:#c9ffdd;margin-bottom:12px}
.tiles{display:grid;grid-template-columns:repeat(auto-fill,minmax(124px,1fr));gap:9px}
.tile{display:flex;flex-direction:column;align-items:center;gap:6px;padding:15px 6px;background:#0b1410;border:1px solid #1d3d29;border-radius:14px;color:#c9ffdd;font-family:inherit;font-size:10px;letter-spacing:1px;cursor:pointer;text-align:center}
.tile .ic{font-size:22px}
.phead{display:flex;align-items:center;gap:12px;margin-bottom:12px}
.phead h3{margin:0;font-size:13px;letter-spacing:3px;color:#39ff9b}
input,select,textarea{width:100%;background:#0a110e;border:1px solid #22452f;color:#dcffee;font-family:inherit;font-size:14px;padding:11px;border-radius:9px;margin:4px 0}
.row{display:flex;gap:8px;flex-wrap:wrap}.row>*{flex:1;min-width:110px}
.card{background:#0a120e;border:1px solid #1c3a28;border-radius:12px;padding:12px;margin:8px 0}
.card .t{font-size:14px;color:#fff}.card .m{font-size:12px;color:#77a98d;margin-top:3px;line-height:1.5}
.amt{color:#39ff9b;font-weight:700}
.mono{font-size:12px;color:#8fd9b3;word-break:break-all}
.warn{background:#1a1005;border:1px solid #6b4a12;border-radius:10px;padding:10px;font-size:12px;color:#ffd76e;line-height:1.5;margin:6px 0}
.good{background:#08130d;border:1px solid #1f4a30;border-radius:10px;padding:10px;font-size:12px;color:#9dffc8;line-height:1.5;margin:6px 0}
.overlay{position:absolute;inset:0;z-index:60;background:rgba(3,7,5,.96);display:flex;flex-direction:column;align-items:center;justify-content:center;gap:14px;padding:24px;text-align:center}
.overlay h2{font-size:42px;letter-spacing:6px;margin:0;color:#39ff9b}
.foot{font-size:11px;color:#4d7a5f;text-align:center;margin-top:14px;line-height:1.6}
img.thumb{width:100%;border-radius:8px;border:1px solid #1c3a28;margin-top:5px}
.step{display:flex;gap:11px;padding:8px 0;border-bottom:1px solid #12251a}
.snum{flex:0 0 25px;height:25px;border-radius:50%;background:#39ff9b;color:#04140b;font-weight:900;display:flex;align-items:center;justify-content:center;font-size:13px}
.stext{font-size:13px;line-height:1.5}
pre{background:#050806;border:1px solid #1c3a28;border-radius:10px;padding:11px;font-size:12px;line-height:1.55;color:#c9ffdd;white-space:pre-wrap;word-break:break-word}
ul.ck{list-style:none;padding:0;margin:0}ul.ck li{display:flex;gap:8px;align-items:flex-start;padding:7px 0;border-bottom:1px solid #12251a;font-size:13px}
ul.ck input{width:auto;margin:2px 0 0}
.bar{height:8px;background:#0d1a12;border-radius:99px;overflow:hidden;border:1px solid #1c3a28;margin:8px 0}
.bar i{display:block;height:100%;background:linear-gradient(90deg,#1f6b45,#39ff9b)}
</style></head><body style="margin:0;background:#06080b"><div id="ccApp">
  <div id="lockScreen">
    <div class="brand">CHA CHING</div><div class="brand2">V A U L T</div>
    <div class="lockbox"><div class="dots" id="dots"></div><div class="pad" id="pad"></div><div class="hint" id="lockHint">Type 4 numbers to make your PIN</div></div>
    <div class="foot">FIRST TIME? TYPE 4 NUMBERS — THEN THE SAME 4 AGAIN.</div>
  </div>
  <div id="mainScreen" class="hide">
    <div class="top"><h1>CHA CHING</h1><div class="balchip" id="bal">$0.00</div><button class="save" id="goPhone">📱 GET ON PHONE</button><button class="mini" id="lockBtn">LOCK</button></div>
    <div class="banner" id="banner">15 windows. AGENTS keeps the story straight.</div>
    <div id="tiles" class="tiles"></div>
    <div id="panel" class="hide"><div class="phead"><button class="mini" id="pback">‹ BACK</button><h3 id="ptitle"></h3></div><div id="pbody"></div></div>
    <div class="foot">15 MODULES · ONE WALLET</div>
  </div>
  <div id="alarmOverlay" class="overlay hide"><h2>CHA CHING</h2><div style="font-size:30px;color:#fff" id="alarmAmt">$0.00</div><div id="alarmList" class="mono"></div><button class="save" id="stopAlarm">STOP THE MUSIC</button></div>
</div><script id="ccjs">
(function(){
const ORIG=document.getElementById('ccApp').innerHTML;
const LS={get(k,d){try{const v=localStorage.getItem(k);return v?JSON.parse(v):d;}catch(e){return d;}},set(k,v){try{localStorage.setItem(k,JSON.stringify(v));return true;}catch(e){return false;}}};
const el=id=>document.getElementById(id);
const uid=()=>Math.random().toString(36).slice(2,9);
const today=()=>{const d=new Date();return d.getFullYear()+'-'+String(d.getMonth()+1).padStart(2,'0')+'-'+String(d.getDate()).padStart(2,'0');};
const money=n=>'$'+Number(n||0).toFixed(2).replace(/\B(?=(\d{3})+(?!\d))/g,',');

let wallet=LS.get('cc_wallet',{tx:[]});
const saveWallet=()=>LS.set('cc_wallet',wallet);
const balance=()=>wallet.tx.reduce((a,t)=>a+Number(t.amt||0),0);
let alarm=LS.get('cc_alarm',null);
if(!alarm){alarm={pending:[
 {id:uid(),payee:'Terrance Turner',amount:1750.00,availOn:'2026-10-23',src:'BofA 1051',fired:false},
 {id:uid(),payee:'Terrance Turner',amount:2500.00,availOn:'2026-10-24',src:'BofA 1052',fired:false},
 {id:uid(),payee:'Anthony W. Nourse',amount:6504.42,availOn:'2026-10-27',src:'Republic Finance 190681217',fired:false}],log:[]};LS.set('cc_alarm',alarm);}
const saveAlarm=()=>LS.set('cc_alarm',alarm);
let checks=LS.get('cc_checks',[]);const saveChecks=()=>LS.set('cc_checks',checks);
let cards=LS.get('cc_cards',[]);

let actx=null;
function AC(){if(!actx)actx=new (window.AudioContext||window.webkitAudioContext)();return actx;}
const NOTE={C:0,'C#':1,D:2,'D#':3,E:4,F:5,'F#':6,G:7,'G#':8,A:9,'A#':10,B:11};
function fq(n){const m=/^([A-G]#?)(\d)$/.exec(n);return 440*Math.pow(2,(((+m[2]+1)*12+NOTE[m[1]])-69)/12);}
const MEL=[['E5',1],['E5',1],['E5',1],['D5',.5],['C5',.5],['D5',1],['C5',.5],['B4',.5],['A4',2],['A4',.5],['B4',.5],['C5',1],['B4',.5],['A4',.5],['G4',2],['E5',1],['E5',1],['E5',1],['D5',.5],['C5',.5],['D5',1],['C5',.5],['B4',.5],['A4',2]];
const BASS=['A2','A2','E2','E2','F2','F2','G2','G2'];
function blip(o,f,st,dur,t,g){const os=actx.createOscillator(),v=actx.createGain();os.type=t;os.frequency.value=f;
v.gain.setValueAtTime(0.0001,st);v.gain.linearRampToValueAtTime(g,st+.015);v.gain.setValueAtTime(g,st+dur*.72);v.gain.linearRampToValueAtTime(0.0001,st+dur);
os.connect(v);v.connect(o);os.start(st);os.stop(st+dur+.03);}
function playMoney(p){try{const ac=AC();ac.resume();const m=ac.createGain();m.gain.value=.95;const c=ac.createDynamicsCompressor();m.connect(c);c.connect(ac.destination);
const b=.44;let t=ac.currentTime+.1;for(let k=0;k<p;k++){let mt=t;MEL.forEach(([n,d])=>{blip(m,fq(n),mt,d*b,'square',.20);mt+=d*b;});
let bt=t,i=0;while(bt<mt){blip(m,fq(BASS[i%8]),bt,b*.92,'triangle',.30);bt+=b;i++;}t=mt+b*.45;}}catch(e){}}
function killSound(){if(actx){try{actx.close();}catch(e){}actx=null;}}
let ringing=false;
function dueNow(){const t=today();return alarm.pending.filter(p=>!p.fired&&p.availOn<=t);}
function checkAlarm(){if(ringing)return;const d=dueNow();if(d.length)fireAlarm(d);}
function fireAlarm(due){ringing=true;el('alarmAmt').textContent=money(due.reduce((a,p)=>a+Number(p.amount||0),0));
el('alarmList').innerHTML=due.map(p=>p.payee).join('<br>');el('alarmOverlay').classList.remove('hide');playMoney(3);
if(navigator.vibrate)try{navigator.vibrate([400,140,400,140,700]);}catch(e){}
due.forEach(p=>{p.fired=true;alarm.log.unshift({d:today(),payee:p.payee,amount:p.amount});});saveAlarm();}
el('stopAlarm').onclick=()=>{killSound();el('alarmOverlay').classList.add('hide');ringing=false;};
setInterval(()=>{if(!el('mainScreen').classList.contains('hide'))checkAlarm();},30000);

let pin=LS.get('cc_pin',null),buf='',mode=pin?'unlock':'new',first='';
function drawDots(){el('dots').innerHTML=[0,1,2,3].map(i=>'<div class="dot'+(i<buf.length?' on':'')+'"></div>').join('');}
function setHint(t){el('lockHint').textContent=t;}
function buildPad(){const k=['1','2','3','4','5','6','7','8','9','CLR','0','OK'];
el('pad').innerHTML=k.map(x=>'<button class="'+(x.length>1?'act':'')+'" data-k="'+x+'">'+x+'</button>').join('');
el('pad').querySelectorAll('button').forEach(b=>b.onclick=()=>key(b.dataset.k));}
function key(k){if(k==='CLR'){buf='';drawDots();return;}if(k==='OK'){submit();return;}if(buf.length<4){buf+=k;drawDots();}if(buf.length===4)setTimeout(submit,160);}
function submit(){
 if(mode==='unlock'){if(buf===pin){buf='';drawDots();unlock();}else{setHint('WRONG PIN - TRY AGAIN');buf='';drawDots();}}
 else if(mode==='new'){first=buf;buf='';drawDots();mode='confirm';setHint('Now type the SAME 4 again');}
 else if(mode==='confirm'){if(buf===first){pin=buf;LS.set('cc_pin',pin);buf='';drawDots();unlock();}else{setHint('Did not match - start over');buf='';first='';mode='new';drawDots();}}}
function unlock(){el('lockScreen').classList.add('hide');el('mainScreen').classList.remove('hide');renderHome();setTimeout(checkAlarm,450);}
el('lockBtn').onclick=()=>{el('panel').classList.add('hide');el('tiles').classList.remove('hide');el('mainScreen').classList.add('hide');el('lockScreen').classList.remove('hide');buf='';drawDots();mode='unlock';setHint('Type your PIN');};
buildPad();drawDots();

function appHTML(){let css='';const s=document.getElementById('cccss')||document.querySelector('style');if(s&&s.outerHTML)css=s.outerHTML;
 const js=el('ccjs').textContent;
 return '<!doctype html><html><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover"><meta name="theme-color" content="#06080b"><title>Cha Ching Vault</title>'+css+'</head><body style="margin:0;background:#06080b">'+'<div id="ccApp">'+ORIG+'</div>'+'<scr'+'ipt id="ccjs">'+js+'</scr'+'ipt></body></html>';}
function doCopy(){const t=document.createElement('textarea');t.value=appHTML();t.setAttribute('readonly','');t.style.cssText='position:absolute;left:-9999px';document.body.appendChild(t);t.select();t.setSelectionRange(0,t.value.length);
 let ok=false;try{ok=document.execCommand('copy');}catch(e){}if(!ok&&navigator.clipboard){try{navigator.clipboard.writeText(t.value);ok=true;}catch(e){}}t.remove();return ok;}

const TILES=[
{id:'wallet',ic:'&#128176;',name:'WALLET'},{id:'alarm',ic:'&#9200;',name:'CLEAR ALARM'},
{id:'check',ic:'&#128228;',name:'MOBILE CHECK'},{id:'sched',ic:'&#128197;',name:'SCHEDULER'},
{id:'crack',ic:'&#128273;',name:'CARD CRACKER'},{id:'valid',ic:'&#9878;',name:'VALIDATOR'},
{id:'steal',ic:'&#128220;',name:'STATEMENT'},{id:'cpn',ic:'&#127380;',name:'CPN + EIN'},
{id:'forge',ic:'&#127470;',name:'ID FORGE'},{id:'ein',ic:'&#128224;',name:'EIN BOT'},
{id:'war',ic:'&#128202;',name:'WAR ROOM'},{id:'agents',ic:'&#129302;',name:'AGENTS'},
{id:'cannon',ic:'&#128163;',name:'CODE CANNON'},{id:'run',ic:'&#128203;',name:'RUNBOOK'},
{id:'set',ic:'&#9881;',name:'SETTINGS'}];
function renderHome(){el('bal').textContent=money(balance());
el('tiles').innerHTML=TILES.map(t=>'<button class="tile" data-v="'+t.id+'"><span class="ic">'+t.ic+'</span><span>'+t.name+'</span></button>').join('');
el('tiles').querySelectorAll('.tile').forEach(b=>b.onclick=()=>open(b.dataset.v));}
function open(id){el('tiles').classList.add('hide');el('panel').classList.remove('hide');VIEWS[id]();}
el('pback').onclick=()=>{el('panel').classList.add('hide');el('tiles').classList.remove('hide');renderHome();};
function head(t){el('ptitle').textContent=t;}function body(h){el('pbody').innerHTML=h;}
const VIEWS={};
function step(n,t){return '<div class="step"><div class="snum">'+n+'</div><div class="stext">'+t+'</div></div>';}

VIEWS.getphone=function(){head('GET ON PHONE');
 body(step(1,'Tap COPY THE CODE')+step(2,'Open github.com/truktturna18-alt/cc')+step(3,'Open index.html, tap the pencil, Select all, Paste, Commit')+step(4,'Wait 2 min, reload your link')+
 '<button class="save" id="bc" style="width:100%;margin-top:12px">&#128203; COPY THE CODE</button><div id="cm" class="card"></div>');
 el('bc').onclick=()=>{el('cm').innerHTML=doCopy()?'<b style="color:#39ff9b">COPIED.</b>':'Copy failed — use SHOW ME THE CODE in Settings.';};};
el('goPhone').onclick=()=>{el('tiles').classList.add('hide');el('panel').classList.remove('hide');VIEWS.getphone();};

/* ============ AGENTS ============ */
let prof=LS.get('cc_prof',{A:{},B:{},cur:'A'});
const saveProf=()=>LS.set('cc_prof',prof);
const PF=[['n','Full name'],['d','DOB'],['a','Address'],['c','City ST ZIP'],['p','Phone'],['m','Email'],['s','SSN / CPN'],['e','EIN'],['emp','Employer'],['inc','Monthly income'],['bank','Bank + acct last 4'],['age','Months of credit file']];
function pblock(){
  const q=prof[prof.cur]||{};
  return PF.map(([k,l])=>l.toUpperCase()+': '+(q[k]||'—')).join('\n');
}
VIEWS.agents=function(){head('AGENTS');
 const q=prof[prof.cur]||{};
 body('<div class="card"><div class="row"><div><div class="m">PROFILE</div><select id="pc"><option value="A" '+(prof.cur==='A'?'selected':'')+'>A — your name</option><option value="B" '+(prof.cur==='B'?'selected':'')+'>B — stranger</option></select></div></div>'+
 PF.map(([k,l])=>'<input id="f_'+k+'" placeholder="'+l+'" value="'+(q[k]||'').replace(/"/g,'&quot;')+'">').join('')+
 '<button class="mini" id="psv">SAVE PROFILE</button></div>'+
 '<div class="card"><div class="m">AGENTS</div>'+
 '<button class="mini" id="ag1" style="margin-top:6px">CONSISTENCY</button> <button class="mini" id="ag2">CAMOUFLAGE</button> <button class="mini" id="ag3">CAPS</button> <button class="mini" id="ag4">SEQUENCE</button> <button class="mini" id="ag5">PAPER</button></div>'+
 '<div id="ao"></div>');
 el('pc').onchange=()=>{prof.cur=el('pc').value;saveProf();VIEWS.agents();};
 el('psv').onclick=()=>{const o={};PF.forEach(([k])=>o[k]=el('f_'+k).value.trim());prof[prof.cur]=o;saveProf();el('ao').innerHTML='<div class="good">Saved to profile '+prof.cur+'.</div>';};
 el('ag1').onclick=()=>{const miss=PF.filter(([k])=>!(prof[prof.cur]||{})[k]).map(([,l])=>l);
  el('ao').innerHTML='<div class="card"><div class="m">PASTE THIS EXACTLY INTO EVERY APPLICATION</div><pre>'+pblock()+'</pre>'+
  (miss.length?'<div class="warn">MISSING: '+miss.join(', ')+'</div>':'<div class="good">All fields present.</div>')+
  '<div class="m">Never retype by hand. Every variation splits the file.</div></div>';};
 el('ag2').onclick=()=>{const x=prof[prof.cur]||{};const t=[];
  t.push(['Phone present',!!x.p]);t.push(['Email matches name',!!(x.m&&x.n&&x.m.toLowerCase().includes(x.n.split(' ')[0].toLowerCase().slice(0,4)))]);
  t.push(['Address looks residential',!!(x.a&&/\d/.test(x.a))]);t.push(['Credit file 6+ months',Number(x.age||0)>=6]);
  t.push(['Income stated',!!x.inc]);t.push(['Bank account attached',!!x.bank]);t.push(['EIN present',!!x.e]);
  const pass=t.filter(v=>v[1]).length,pct=Math.round(pass/t.length*100);
  el('ao').innerHTML='<div class="card"><div class="t">CAMOUFLAGE '+pct+'%</div><div class="bar"><i style="width:'+pct+'%"></i></div>'+
  t.map(([l,ok])=>'<div class="mono">'+(ok?'&#10003;':'&#10007;')+' '+l+'</div>').join('')+
  '<div class="m" style="margin-top:8px">Below 85% = you look new. Fix the crosses before applying. A phone in the profile name, a 60-day-old bank account and a stable address are the three that matter most.</div></div>';};
 el('ag3').onclick=()=>{const p=alarm.pending.filter(v=>!v.fired).sort((a,b)=>a.amount-b.amount);
  let out='';let d=2000;
  p.forEach(v=>{if(v.amount>2000){out+='<div class="warn">'+v.payee+' '+money(v.amount)+' — OVER the $2,000 daily cap. Mail it or use a credit union.</div>';}
   else if(d>=v.amount){d-=v.amount;out+='<div class="good">Today: '+v.payee+' '+money(v.amount)+' — '+money(d)+' left on the cap.</div>';}
   else{out+='<div class="warn">'+v.payee+' '+money(v.amount)+' — tomorrow. Only '+money(d)+' left today.</div>';}});
  el('ao').innerHTML='<div class="card">'+(out||'<div class="m">nothing pending</div>')+'<div class="m" style="margin-top:8px">Caps: $2,000/day, $5,000/week, $10,000/month.</div></div>';};
 el('ag4').onclick=()=>{const x=prof[prof.cur]||{};const m=Number(x.age||0);let out='';
  if(m<3)out='<div class="warn">File under 3 months. Open credit builders only. No real cards yet.</div>';
  else if(m<6)out='<div class="warn">3-6 months. One starter card max. Soft-pull prequal first.</div>';
  else if(m<12)out='<div class="good">6-12 months. Apply for a real card. Space apps 90 days apart.</div>';
  else out='<div class="good">12+ months. Credit union for real limits. The $5,000 loan is open.</div>';
  el('ao').innerHTML='<div class="card">'+out+'<div class="m" style="margin-top:8px">Never two applications inside 14 days. Alternate lenders between profiles A and B.</div></div>';};
 el('ag5').onclick=()=>{const x=prof[prof.cur]||{};
  el('ao').innerHTML='<div class="card"><div class="m">CHECK ENDORSEMENT — write on the back, top edge</div><pre>For Mobile Deposit Only\nto OnePay\nAcct 11059962101\n'+(x.n||'NAME')+'\n'+today()+'</pre>'+
  '<div class="m">DEPOSIT SLIP MEMO LINE</div><pre>Deposit — '+(x.n||'NAME')+' — chk #____</pre>'+
  '<div class="m">Keep the stamp inside the DO NOT WRITE line.</div></div>';};
};

/* ---------- WALLET ---------- */
VIEWS.wallet=function(){head('WALLET');
 const tx=[...wallet.tx].sort((a,b)=>(b.date||'').localeCompare(a.date||''));
 body('<div class="card"><div class="m">TOTAL</div><div style="font-size:26px" class="amt">'+money(balance())+'</div></div>'+
 '<div class="card"><input id="wd" placeholder="What"><input id="wa" placeholder="Amount" inputmode="decimal"><button class="mini" id="wadd">ADD</button></div>'+
 tx.map(t=>'<div class="card"><div class="t">'+t.desc+' <span class="amt">'+money(t.amt)+'</span></div><div class="m">'+(t.date||'')+'</div><button class="mini" data-del="'+t.id+'">DELETE</button></div>').join(''));
 el('wadd').onclick=()=>{const a=parseFloat(el('wa').value||'0');if(!a)return;wallet.tx.push({id:uid(),date:today(),desc:el('wd').value||'entry',amt:a,src:'manual'});saveWallet();VIEWS.wallet();};
 el('pbody').querySelectorAll('[data-del]').forEach(b=>b.onclick=()=>{wal
